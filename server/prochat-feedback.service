[Unit]
Description=ProChat update manifest and feedback board
After=network.target

[Service]
Type=simple
User=prochat
Group=prochat
WorkingDirectory=/opt/prochat-feedback
ExecStart=/usr/local/bin/node /opt/prochat-feedback/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/prochat-feedback/data /opt/prochat-feedback/public
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
